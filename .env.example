# API-ключ Яндекс AI Studio (YandexGPT API).
# Используется только на сервере и никогда не попадает в браузер.
# Если не задан — приложение работает на приблизительной генерации.
# Получить ключ: кабинет Яндекс AI Studio (aistudio.yandex.ru) → «API-ключи».
YANDEXGPT_API_KEY=

# Идентификатор каталога в Яндекс Облаке (необязательно, для части ключей).
# YANDEXGPT_FOLDER_ID=

# URI модели (необязательно). По умолчанию gpt://yandexgpt-lite/latest.
# YANDEXGPT_MODEL_URI=