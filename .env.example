# API-ключ RouterAI (OpenRouter-совместимый API).
# Используется только на сервере и никогда не попадает в браузер.
# Если не задан — приложение работает на приблизительной генерации.
# Получить ключ: https://routerai.ru → API-ключи.
ROUTERAI_API_KEY=

# Базовый URL API (необязательно). По умолчанию https://routerai.ru/api/v1.
# ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Модель (необязательно). По умолчанию openai/gpt-4o-mini.
# Доступные модели: https://routerai.ru/models
# ROUTERAI_MODEL=openai/gpt-4o-mini

# Домен для развёртывания (Coolify / Traefik).
# Укажите ваш домен, например: semanticai.example.com
# DOMAIN=semanticai.example.com
